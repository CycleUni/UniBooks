# Build-time values for the production frontend that only the frontend uses,
# read by `npm run build` (scripts/set-env.js) — which the server Worker's
# `npm run deploy` runs through `npm run build:fe`. Every value here ends up in
# the public bundle or its headers anyway: nothing secret belongs in this file.
# A variable already set in the environment (CI) wins over the line here.
#
# Values shared with the server (R2_PUBLIC_URL, GOOGLE_CLIENT_ID, SENTRY_DSN) are not
# repeated here: set-env.js reads them from server/wrangler.jsonc "vars", so
# the two halves can never disagree. The API is this origin's /api/v1, so
# there is no backend URL either.
NG_APP_CSP_ENFORCE=1
NG_APP_GA_MEASUREMENT_ID=G-QXSV9KL0G2
