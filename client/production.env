# Build-time values for the production frontend, read by `npm run build`
# (scripts/set-env.js) — which is what the server Worker's `npm run deploy`
# runs through `npm run build:fe`. They replace the [vars] of the old
# Cloudflare Pages wrangler.toml. Every value here ends up in the public
# bundle or its headers anyway (OAuth client ID, GA ID, Sentry DSN, media
# host): nothing secret belongs in this file. A variable already set in the
# environment (CI) wins over the line here.
#
# R2_PUBLIC_URL and GOOGLE_CLIENT_ID match server/wrangler.jsonc "vars"
# exactly. FRONTEND_URL is this build's own: the site origin, used only to name
# its wss: origin in the CSP (the server has no such var; it uses the request
# origin). NG_APP_BACKEND_URL is deliberately absent: the API is this
# origin's /api/v1.
#R2_PUBLIC_URL=https://assets.unibooks.app
FRONTEND_URL=https://unibooks.app
NG_APP_CSP_ENFORCE=1
NG_APP_GA_MEASUREMENT_ID=G-QXSV9KL0G2
NG_APP_SENTRY_DSN=https://d3502cafa5f40551209d70b1552f1e59@o4512117291876352.ingest.us.sentry.io/4512211885096960
GOOGLE_CLIENT_ID=101715747117-7076qd90bgjpvo7hca6e1rk913ke570c.apps.googleusercontent.com

