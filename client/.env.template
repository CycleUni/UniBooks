# UniBooks-FE 環境變數範本
# 本檔僅列鍵名，不得含任何實際機密值。複製此檔為 .env 以供本地開發使用。
#
# 這些變數是由 scripts/set-env.js 在 build / test / serve 前讀取的
# （見 package.json 的 --env-file-if-exists=.env），不是 Angular CLI 的機制——
# Angular 本身沒有環境變數替換功能。該腳本會據此產生 src/environments/*.ts，
# 並改寫 public/_headers 裡的 CSP。正式建置（`npm run build`）讀的是 production.env，不是 .env；
# 在 CI 設定同名環境變數則會蓋過檔案裡的值。
#
# 命名規則：只有前端會用到的值加 NG_APP_ 前綴；與 server 共用的值不在本檔（見檔尾）。

# ---- 前端專用 ----

# 後端 API 網址 (選填)
# 預設為 /api/v1：App、API 與聊天室都由同一支 Worker（UniBooks/server）在同一個
# origin 提供，所以正式建置不需要設定這個值。只有想讓本地建置改連別的 API 時才填，
# 例如 http://127.0.0.1:8787/api/v1。`npm start`（ng serve）不必填：
# proxy.conf.json 會把 /api（含 /api/chat 的 WebSocket）轉發到 http://localhost:8787（server 的 wrangler dev）。
NG_APP_BACKEND_URL=

# Google Analytics 4 評估 ID (選填)
# 若留空則不會載入 GA 追蹤碼。格式如：G-XXXXXXXXXX
NG_APP_GA_MEASUREMENT_ID=

# Sentry DSN (選填)
# 若留空則不會啟用 Sentry 錯誤回報。DSN 為公開的上報位址，非機密。
# 取自 Sentry 專案設定 > Client Keys (DSN)。
NG_APP_SENTRY_DSN=

# SSR 允許的主機網域 (選填，多個網域請用半形逗號分隔)
# 預設為空時，只允許 angular.json 中寫死的 localhost。
# 部署至 Cloudflare 等平台時，請填入正式網域以允許 SSR。
# 範例：unibooks.app, localhost, 127.0.0.1
NG_APP_ALLOWED_HOSTS=

# 是否強制執行完整的 CSP (選填，設為 1 才生效)
# 留空時：一組「零風險」指令（object-src / frame-ancestors / base-uri /
# form-action）仍會強制執行，完整政策則以 Report-Only 模式收集違規。
# 設為 1 時：完整政策改為強制執行——請先在已部署環境開 console 走過
# Google 登入、上傳照片、聊天室、書籍頁，確認沒有任何違規訊息再開啟，
# 否則 connect-src 若漏掉某個主機，App 會直接無法運作。
NG_APP_CSP_ENFORCE=

# ---- 與 server Worker 共用的設定 ----
#
# R2_PUBLIC_URL、GOOGLE_CLIENT_ID 不在這裡設定：scripts/set-env.js 直接讀
# server/wrangler.jsonc 的 "vars"（正式值），本地 `npm start`／`npm test`
# 再疊上 server/.dev.vars。前後端只有一份來源，值不會不一致。
# CI 若已設定同名環境變數，則以環境變數為準。
