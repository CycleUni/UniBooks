{
  "name": "unibooks-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "wrangler d1 migrations apply unibooks-apac --local && wrangler d1 migrations apply unibooks-ads-apac --local",
    "dev": "wrangler dev --port 8787 --test-scheduled",
    "build:fe": "npm --prefix ../client run build",
    "start": "npm run build:fe:local && npm run dev",
    "deploy": "npm run build:fe && wrangler deploy && wrangler d1 migrations apply unibooks-apac --remote && wrangler d1 migrations apply unibooks-ads-apac --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate && drizzle-kit generate --config drizzle.ads.config.ts",
    "db:seed": "wrangler d1 execute unibooks-apac --local --file src/db/seed.sql",
    "db:seed:remote": "wrangler d1 execute unibooks-apac --remote --file src/db/seed.sql",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "user:create": "node --experimental-strip-types scripts/create-user.ts",
    "build:fe:local": "npm --prefix ../client run build:local"
  },
  "dependencies": {
    "@sentry/cloudflare": "^11.6.0",
    "@simplewebauthn/server": "^14.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261012.1",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
