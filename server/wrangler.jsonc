{
  "$schema": "node_modules/wrangler/config-schema.json",
  // One Worker serves the whole site: the Angular build (static assets), the
  // REST API (/api/v1/*), chat (/api/chat/*) and link-preview book pages.
  "name": "unibooks",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Only these paths invoke the Worker; every other request is served from
  // static assets without a Worker invocation (and without billing one).
  "assets": {
    "directory": "../client/dist/unibooks/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/*/book"]
  },

  // Resources are provisioned by name on first deploy (no ids in config).
  "d1_databases": [
    { "binding": "DB", "database_name": "unibooks", "migrations_dir": "src/db/migrations" },
    // Ads live apart from marketplace data so they can move or scale on their own.
    { "binding": "DB_ADS", "database_name": "unibooks-ads", "migrations_dir": "src/db/ads-migrations" }
  ],
  "kv_namespaces": [{ "binding": "KV" }],
  "r2_buckets": [{ "binding": "R2", "bucket_name": "unibooks-assets" }],

  // Ad impressions and clicks: append-only events, queried via the SQL API.
  "analytics_engine_datasets": [{ "binding": "AD_EVENTS", "dataset": "unibooks_ad_events" }],

  // Per-client caps on the public ad endpoints (list; view/click events) and on
  // all of /api: the
  // platform's own counters, so a hit costs no Durable Object call. namespace_id is a label chosen here
  // (unique per account), not a provisioned resource id.
  "ratelimits": [
    { "name": "AD_STATS_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } },
    { "name": "AD_LIST_LIMIT", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    // Loose last resort under every /api route (middleware/rateLimit.ts apiThrottle),
    // per client address. A refused request already ran the Worker, so this saves
    // D1 and Durable Object work, not requests; the Cloudflare rules in front are
    // the real limit (100 per 10 s), and routes keep their own, stricter ones.
    { "name": "API_READ_LIMIT", "namespace_id": "1003", "simple": { "limit": 1500, "period": 60 } },
    { "name": "API_WRITE_LIMIT", "namespace_id": "1004", "simple": { "limit": 300, "period": 60 } }
  ],

  // The ISBNnet resolver Worker, called in-process instead of over the internet.
  "services": [{ "binding": "ISBNNET", "service": "isbnnet-resolver" }],

  "durable_objects": {
    "bindings": [
      { "name": "CHAT_ROOM", "class_name": "ChatRoom" },
      { "name": "USER_HUB", "class_name": "UserHub" },
      { "name": "ORDER_LOCK", "class_name": "OrderLock" },
      { "name": "RATE_LIMITER", "class_name": "RateLimiter" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoom", "UserHub", "OrderLock", "RateLimiter"] }],

  "queues": {
    "producers": [
      { "binding": "EMAIL_QUEUE", "queue": "unibooks-email" },
      { "binding": "PUSH_QUEUE", "queue": "unibooks-push" }
    ],
    "consumers": [
      { "queue": "unibooks-email", "max_batch_size": 10, "max_batch_timeout": 2, "max_retries": 5 },
      { "queue": "unibooks-push", "max_batch_size": 20, "max_batch_timeout": 10, "max_retries": 3 }
    ]
  },

  // Each expression is dispatched by name in src/jobs/index.ts.
  "triggers": { "crons": ["0 */6 * * *", "*/30 * * * *", "0 3 * * *"] },

  // Non-secret configuration (production values; .dev.vars overrides locally).
  // Secrets — set with `wrangler secret put`: SECRET_KEY,
  // MAILJET_API_KEY, MAILJET_SECRET_KEY,
  // GOOGLE_BOOKS_API_KEY, FIREBASE_SERVICE_ACCOUNT_JSON, CF_ANALYTICS_TOKEN,
  // ISBNNET_RESOLVER_SECRET (optional).
  // Ad statistics also need CF_ANALYTICS_TOKEN (secret); without it the admin
  // shows no view/click counts. CF_ACCOUNT_ID below is not a secret.
  "vars": {
    "ENVIRONMENT": "production",
    "DEFAULT_REGION": "TW",
    "CF_ACCOUNT_ID": "b74f839e7706a8d8e249168846802c14",
    "R2_PUBLIC_URL": "https://assets.unibooks.app",
    "ALLOWED_IMAGE_HOSTS": "assets.unibooks.app",
    "DEFAULT_FROM_EMAIL": "services@unibooks.app",
    "GOOGLE_CLIENT_ID": "101715747117-7076qd90bgjpvo7hca6e1rk913ke570c.apps.googleusercontent.com",
    // Sentry DSN (public: it ships in the app bundle anyway). One Sentry
    // project for the Worker and the app, so a page's trace runs into the
    // API it calls; client/scripts/set-env.js reads it from here. Empty: off.
    "SENTRY_DSN": "https://b5fe34378b4c674ee433d8e672dedaae@o4512117291876352.ingest.us.sentry.io/4512259160801280",
    // Cloudflare Turnstile site key (public). With it and the TURNSTILE_SECRET_KEY
    // secret, sign-in, registration and asking for a password reset link always
    // need a challenge (sign-in no longer locks an account after wrong
    // passwords); client/scripts/set-env.js reads the key from here. Empty: off.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFXU0IYptAGunf16"
  },

  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true
    }
  }
}
