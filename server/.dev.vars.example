# Copy to .dev.vars for `wrangler dev` / `npm run dev`. Values here override the
# production `vars` in wrangler.jsonc and supply what production keeps in
# `wrangler secret put`. Never put real production secrets in this file.
ENVIRONMENT=development
# Links in emails/pushes built outside a request (queues, cron)
SITE_ORIGIN=http://localhost:8787

# Local R2 is simulated by wrangler; the Worker serves it under /api/media in dev.
R2_PUBLIC_URL=http://localhost:8787/api/media
ALLOWED_IMAGE_HOSTS=localhost

# Required (each at least 32 characters).
# Master secret (32+ chars); every signing key is derived from it. Generate one: openssl rand -base64 48
SECRET_KEY=change-me-dev-only-at-least-32-characters-long

# Email via Mailjet (optional locally; without keys emails are logged and skipped).
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
DEFAULT_FROM_EMAIL=no-reply@example.com

# Book lookups.
GOOGLE_BOOKS_API_KEY=
# Google Books calls per minute across the whole Worker (default 60); may also go in wrangler.jsonc vars.
# GOOGLE_BOOKS_PER_MINUTE=60
# Used only when the ISBNNET service binding is not running locally.
ISBNNET_RESOLVER_URL=
ISBNNET_RESOLVER_SECRET=

# Google sign-in (public client id).
GOOGLE_CLIENT_ID=

# Optional: push (FCM), ad statistics (Analytics Engine SQL API).
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FCM_WEB_API_KEY=
FCM_WEB_APP_ID=
FCM_MESSAGING_SENDER_ID=
FCM_VAPID_KEY=
CF_ACCOUNT_ID=
CF_ANALYTICS_TOKEN=

# Sentry: production's DSN is in wrangler.jsonc vars and reaches the app build
# too. Keep this line empty so local runs report nothing; put a DSN here to try it.
SENTRY_DSN=

# Cloudflare Turnstile (optional): sign-in, registration and password reset requests always need a challenge.
# These are Cloudflare's public test keys (always pass). Production: a real widget's keys,
# the site key in wrangler.jsonc vars and the secret via `wrangler secret put TURNSTILE_SECRET_KEY`.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
